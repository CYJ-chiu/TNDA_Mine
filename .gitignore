#
# Get latest from https://github.com/github/gitignore/blob/master/UnrealEngine.gitignore
#

# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig
*.slnx

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Ignore Binaries
Binaries/*/*
Plugins/*/Binaries/*/*

# Excluding Binaries for Ediotor
Binaries/Win64/*.target
Binaries/Win64/*.modules
Binaries/Win64/UnrealEditor*.dll
Binaries/Win64/UnrealEditor*.pdb
Plugins/*/Binaries/Win64/*.modules
Plugins/*/Binaries/Win64/*.dll
Plugins/*/Binaries/Win64/*.pdb

# Ignore DebugGame, Shipping Binaries
Binaries/*/*DebugGame.target
Binaries/*/*Shipping.target
Binaries/*/*DebugGame.modules
Binaries/*/*DebugGame.dll
Binaries/*/*DebugGame.pdb
Binaries/*/*Shipping.pdb
Plugins/*/Binaries/*/*DebugGame.modules
Plugins/*/Binaries/*/*DebugGame.dll
Plugins/*/Binaries/*/*DebugGame.pdb

# Ignore other Binaries, ex: UnrealEditor-SGF.patch_0.pdb
Binaries/*/*.*.*
Plugins/*/Binaries/*/*.*.*

# Builds
Build/*
Build-*/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico
!Build/Android/res/
!Build/Android/res/**
!Build/IOS/Resources/
!Build/IOS/Resources/**

# Built data for maps
#*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# Starter Content
Content/StarterContent/*

# 錯誤追蹤系統
.sentry-native

# Windows image file caches
Thumbs.db
ehthumbs.db

# Temp files when opening LibreOffice on ubuntu
.~lock.*

# Ignore all folder start with ~
**/~*/

# Ignore all file start with ~
~*

# Ignore Office暫存檔案
.~*

_AI協作
.codegraph


